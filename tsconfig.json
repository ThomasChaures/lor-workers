{
  "compilerOptions": {
    "target": "ES2022",
    // Bundler resolution matches how the front (Next/esbuild) and tsx resolve:
    // extensionless imports + `@/` path aliases, so vendored engine files need
    // zero edits. tsx handles the actual ESM resolution at runtime.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/lib/supabase/admin": ["src/config/supabase.ts"],
      "@/*": ["src/engine/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
