# Supabase — SAME project as the Next app. The service-role key bypasses RLS and
# must NEVER leave the VPS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Riot Games API key (personal or production).
RIOT_API_KEY=
# Region routing for match-v5 (LATAM = americas). Required: drives match fetching.
RIOT_REGION_ROUTING=americas
# Fallback platform when a player has none set (BR = br1, LAN = la1, LAS = la2).
# Only a safety net — the sync path uses each player's own platform.
RIOT_PLATFORM=la2

# Sync tuning (milliseconds).
SYNC_INTERVAL_MS=60000
SYNC_STALE_MS=360000
# Per-player cooldown: skip a player re-synced within this window (default 3 min).
PLAYER_SYNC_COOLDOWN_MS=180000
