{
  "name": "lor-u-workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LeagueOfRankeds worker host — background jobs (match sync, email crons) running on the VPS.",
  "scripts": {
    "dev:sync": "tsx watch src/workers/sync.ts",
    "dev:live": "tsx watch src/workers/live.ts",
    "dev:inhouse": "tsx watch src/workers/inhouse.ts",
    "start:sync": "tsx src/workers/sync.ts",
    "start:emails": "tsx src/workers/emails.ts",
    "start:live": "tsx src/workers/live.ts",
    "start:inhouse": "tsx src/workers/inhouse.ts",
    "typecheck": "tsc --noEmit",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs",
    "pm2:logs": "pm2 logs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pm2": "^5.4.0",
    "typescript": "^5.6.0"
  }
}
